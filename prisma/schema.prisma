generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
     url = env("DATABASE_URL")
    }

model cliente {
    clienteId Int  @id @default(autoincrement())
    nome String
    matricula String @unique
    email String @unique
    senha String
    telefone String
    possuiPendencia Boolean

    criadoEm DateTime @default(now())

    @@map("cliente")
}

model obra {
    obraId Int @id @default(autoincrement())
    exemplarId Int
    isbn String
    titulo exemplar @relation(fields: [exemplarId], references: [exemplarId])
    autor String
    editora String
    genero String

    statusDisponibilidade String @default("Disponível")

    @@map("obra")

}

model exemplar{ 
    exemplarId Int @id @default(autoincrement())
    obraId Int
    obra obra @relation(fields: [obraId], references: [obraId])
    titulo String
    codigoIndetificador String
    estadoDeConservacao String
    status String

    exemplar obra[]

    @@map("exemplar")
}