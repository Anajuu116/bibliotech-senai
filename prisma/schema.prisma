generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
     url = env("DATABASE_URL")
    }

model cliente {
    id Int  @id @default(autoincrement())
    nome String
    matricula String @unique
    email String @unique
    senha String
    telefone String

    criadoEm DateTime @default(now())

    @@map("cliente")
}

model exemplar{ 
    id Int @id @default(autoincrement())
    titulo String
    codigoIndetificador String
    estadoDeConservacao String
    status String

    exemplar obra[]

    @@map("exemplar")
}

model obra {
    id Int @id @default(autoincrement())
    exemplarId Int
    isbn String
    titulo exemplar @relation(fields: [exemplarId], references: [id])
    autor String
    editora String
    genero String

    statusDisponibilidade String @default("Disponível")

    @@map("obra")

}