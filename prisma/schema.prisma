generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url = env("DATABASE_URL")
    }

model cliente {
    id Int  @id @default(autoincrement())
    nome String
    matricula String @unique
    email String @unique
    senha String
    telefone String

    criadoEm DateTime @default(now())

    @@map("cliente")
}